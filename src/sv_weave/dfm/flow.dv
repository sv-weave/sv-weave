package:
  name: svweave
  desc: sv-weave tasks for weaving SystemVerilog class libraries

  tasks:
  - name: Runtime
    scope: export
    desc: SV sources the listed bindings need
    doc: |
      Produces a systemVerilogSource FileSet with the SV sources each listed binding
      needs ahead of the design (Binding.sv_runtime_files). sv-weave itself ships no
      SV runtime; the class library comes from the design's own flow.
    shell: pytask
    run: sv_weave.dfm.tasks.Runtime
    passthrough: all
    consumes: none
    with:
      binding:
        doc: Binding names, or module:Class references
        type: list
        value: []

  - name: Weave
    scope: export
    desc: Weave the upstream SystemVerilog sources
    doc: |
      Runs the sv-weave pipeline over the upstream systemVerilogSource FileSets, in
      order, and outputs them followed by a FileSet of the generated sources (woven
      packages, then the init package) and a jsonManifest FileSet holding
      weave-manifest.json. Diagnostics become markers at their source locations.
    shell: pytask
    run: sv_weave.dfm.tasks.Weave
    # Beyond dv-flow's own checks: the config file's content and the weavers' and
    # bindings' source, through the input hash of the last run.
    uptodate: sv_weave.dfm.tasks.WeaveUpToDate
    # Reads the upstream sources (consumes) and also forwards them, ahead of the
    # woven sources, so a SimImage that needs this task gets everything in order.
    passthrough: all
    consumes: all
    with:
      config:
        doc: Path to sv-weave.yaml (relative to the flow's source directory)
        type: str
        value: ""
      profiles:
        doc: Profiles to build; overrides the config's build-profiles
        type: list
        value: []
      binding:
        doc: Binding names; overrides the config's binding
        type: list
        value: []
      verify:
        doc: Verification level (full, syntax, off); overrides the config's verify
        type: str
        value: ""
      top:
        doc: Top modules to elaborate; added to the config's sources.top
        type: list
        value: []
      init:
        doc: |
          false: write no init files, as the config's init false (the files are
          written only when both are true). Set it on Weave tasks whose outputs
          share an image, and add one svweave.Init after them
        type: bool
        value: true

  - name: Init
    scope: export
    desc: One init package for several Weave tasks
    doc: |
      Reads the jsonManifest FileSets of the upstream svweave.Weave tasks (each with
      init false) and writes one sv_weave_init_pkg.sv and sv_weave_init_m.sv that
      register every woven package they list, in input order. Outputs the upstream
      FileSets followed by a systemVerilogSource FileSet of the two files.
    shell: pytask
    run: sv_weave.dfm.tasks.Init
    passthrough: all
    consumes: all
